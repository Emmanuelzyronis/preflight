# Fastify API port.
PORT=3001
# STRK20 shielded-pool contract on Starknet mainnet.
STRK20_POOL_ADDRESS=
# Read-only Starknet JSON-RPC endpoint. Never put a wallet/private key here.
RPC_URL=
# Optional Privacy SDK proving service URL (required for proof-backed private actions).
PRIVACY_PROVING_URL=
# Optional Privacy SDK discovery/indexer URL.
PRIVACY_DISCOVERY_URL=
# Postgres connection used by the public-event indexer.
DATABASE_URL=postgres://preflight:preflight@localhost:5432/preflight
# Interval between incremental indexer syncs.
SYNC_INTERVAL_MS=60000
# First block to scan when the database has no checkpoint; defaults to latest minus 1000.
INDEXER_START_BLOCK=
