# Fastify API port.
PORT=3001
# Browser origins allowed to call the API. Comma-separated for local + Codespaces.
# Replace the example hostname with your actual forwarded port-5173 URL.
WEB_ORIGINS=http://localhost:5173,https://congenial-cod-x544g6w5rp97hv675-5173.app.github.dev
# Optional convenience for ephemeral Codespaces URLs matching https://*-5173.app.github.dev.
ALLOW_CODESPACES_ORIGINS=true
# Browser-visible API and pool configuration used by the report UI and SDK hook.
VITE_API_URL=http://localhost:3001
VITE_STRK20_POOL_ADDRESS=0x040337b1af3c663e86e333bab5a4b28da8d4652a15a69beee2b677776ffe812a
# STRK20 shielded-pool contract on Starknet mainnet.
STRK20_POOL_ADDRESS=0x040337b1af3c663e86e333bab5a4b28da8d4652a15a69beee2b677776ffe812a
# Read-only Starknet JSON-RPC endpoint. Never put a wallet/private key here.
RPC_URL=https://rpc.starknet.lava.build
# Optional Privacy SDK proving service URL (required for proof-backed private actions).
PRIVACY_PROVING_URL=
# Optional Privacy SDK discovery/indexer URL.
PRIVACY_DISCOVERY_URL=
# Postgres connection used by the public-event indexer.
DATABASE_URL=postgres://preflight:preflight@localhost:5432/preflight
# Isolated Postgres database used only by integration tests; never point tests at DATABASE_URL.
TEST_DATABASE_URL=postgres://preflight:preflight@localhost:5432/preflight_test
# Interval between incremental indexer syncs.
SYNC_INTERVAL_MS=60000
# Maximum number of blocks requested per RPC getEvents chunk.
SCAN_CHUNK_SIZE=2000
# Pool deployment block, verified via mainnet RPC transaction 0xfd34e62abfaf5342c7b50746bee2908a61c8bfc3d67174c8993f19ba874572.
INDEXER_START_BLOCK=8978970
# Demo wallet only -- never use a real user's key here. Set manually and never commit it.
DEMO_WALLET_PRIVATE_KEY=
DEMO_WALLET_ADDRESS=
DEMO_TOKEN_ADDRESS=
DEMO_RECIPIENT_ADDRESS=
