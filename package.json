{
  "name": "preflight-strk20",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace @preflight/web\" \"npm run dev --workspace @preflight/api\"",
    "db:setup": "bash scripts/init-db.sh",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "db:reset": "npm run db:reset --workspace @preflight/api",
    "demo:run": "node --env-file-if-exists=.env --import tsx scripts/demo-wallet/run.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "concurrently": "^9.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "@starkware-libs/starknet-privacy-sdk": "^0.14.3-rc.5"
  }
}
